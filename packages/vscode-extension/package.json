{
  "name": "ies-vscode-extension",
  "displayName": "IES and LDT Light Viewer",
  "version": "0.1.0",
  "description": "Preview IES and EULUMDAT lighting distributions on a floor and wall with an interactive 3D viewer.",
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "3d",
    "eulumdat",
    "ies",
    "ldt",
    "lighting",
    "photometry",
    "preview"
  ],
  "homepage": "https://ies-tools.ben3d.ca/",
  "bugs": {
    "url": "https://github.com/bhouston/ies-tools/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Ben Houston",
    "url": "https://ben3d.ca"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bhouston/ies-tools.git",
    "directory": "packages/vscode-extension"
  },
  "publisher": "benhouston3d",
  "type": "module",
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "tsc --noEmit && tailwindcss -i src/preview/preview.css -o media/preview.css --minify && node scripts/build.mjs",
    "package": "pnpm build && vsce package --no-dependencies"
  },
  "dependencies": {
    "@ies-tools/core": "workspace:*",
    "@ies-tools/viewer": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.27.3",
    "ovsx": "^1.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.18"
  },
  "contributes": {
    "commands": [
      {
        "command": "ies.openPreview",
        "title": "IES: Open Light Preview"
      }
    ],
    "customEditors": [
      {
        "viewType": "ies.lightPreview",
        "displayName": "IES and LDT Light Viewer",
        "selector": [
          {
            "filenamePattern": "*.ies"
          },
          {
            "filenamePattern": "*.IES"
          },
          {
            "filenamePattern": "*.ldt"
          },
          {
            "filenamePattern": "*.LDT"
          }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "ies.openPreview",
          "when": "resourceExtname =~ /\\.(ies|ldt)/i",
          "group": "navigation"
        }
      ]
    }
  },
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  }
}
