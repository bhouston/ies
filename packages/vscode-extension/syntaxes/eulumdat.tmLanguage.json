{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "EULUMDAT (LDT)",
  "scopeName": "source.eulumdat",
  "patterns": [
    {
      "match": "^\\s*[-+]?(?:\\d+(?:[.,]\\d*)?|[.,]\\d+)(?:[eE][-+]?\\d+)?\\s*$",
      "name": "constant.numeric.eulumdat"
    },
    { "match": "^.+$", "name": "string.unquoted.eulumdat" }
  ]
}
