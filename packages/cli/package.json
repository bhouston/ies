{
  "name": "ies",
  "version": "0.1.0",
  "description": "Validate, inspect, convert and preview IES photometric files.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhouston/ies.git",
    "directory": "packages/cli"
  },
  "bin": {
    "ies": "./bin/cli.js"
  },
  "files": [
    "dist",
    "bin",
    "media",
    "!dist/**/*.tsbuildinfo"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && node scripts/build-viewer.mjs",
    "dev": "tsc -w",
    "start": "node bin/cli.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@clidoc/core": "^1.1.2",
    "@clidoc/yargs": "^1.1.2",
    "ies-core": "workspace:*",
    "ies-viewer": "workspace:*",
    "playwright-core": "^1.63.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.4",
    "yargs": "^18.2.0",
    "yargs-file-commands": "^2.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yargs": "^17.0.35",
    "esbuild": "^0.27.3"
  },
  "engines": {
    "node": ">=22"
  }
}
