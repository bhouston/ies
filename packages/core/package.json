{
  "name": "ies-core",
  "version": "0.1.0",
  "description": "Parse, validate, sample and inspect IES LM-63 lighting photometry in Node and browsers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhouston/ies.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  }
}
