{
  "name": "@ies-tools/core",
  "version": "0.1.0",
  "description": "Parse, validate, convert and measure IES LM-63 and EULUMDAT photometry in Node and browsers.",
  "keywords": [
    "conversion",
    "eulumdat",
    "ies",
    "ldt",
    "lighting",
    "lm-63",
    "parser",
    "photometry",
    "typescript",
    "validation"
  ],
  "homepage": "https://ies-tools.ben3d.ca/docs/core",
  "bugs": {
    "url": "https://github.com/bhouston/ies-tools/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhouston/ies-tools.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  }
}
