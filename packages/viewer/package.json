{
  "name": "@ies-tools/viewer",
  "version": "0.1.0",
  "description": "Photometric IES lighting viewer, React components, and light-viewer custom element.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhouston/ies-tools.git",
    "directory": "packages/viewer"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "styles"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/element.js",
    "./dist/light-viewer.js",
    "./dist/viewer.css",
    "./styles/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    },
    "./light-viewer.js": "./dist/light-viewer.js",
    "./graphs": {
      "types": "./dist/graphs.d.ts",
      "default": "./dist/graphs.js"
    },
    "./styles/*": "./styles/*",
    "./styles.css": "./dist/viewer.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p . && node scripts/build-element.mjs"
  },
  "dependencies": {
    "@ies-tools/core": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.18",
    "three": "^0.186.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.186.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
