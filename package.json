{
  "name": "ies-monorepo",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://ies-tools.ben3d.ca/",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -r --filter !ies-docs build",
    "tsc": "pnpm -r --filter !ies-docs exec tsc --noEmit",
    "dev": "pnpm --filter ies-website dev",
    "test": "vitest run",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "docs:build": "pnpm --filter ies-docs build",
    "release": "semantic-release",
    "check:release": "node scripts/check-release.mjs"
  },
  "devDependencies": {
    "@anolilab/semantic-release-pnpm": "^8.1.25",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^22.20.0",
    "@visulima/yaml": "1.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.73.0",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2",
    "vite": "^8.1.3",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,md,mdx,css,html,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.27.0"
}
